---
import { getEntry } from 'astro:content';
import '../styles/global.css';

interface Props {
  title?: string;
}

const profile = await getEntry('profile', 'profile');
if (!profile) throw new Error('Profile content is missing.');

const { site } = profile.data;
const { title } = Astro.props;
const documentTitle = title ? `${title} | ${site.title}` : site.title;
const initials = site.title
  .split(' ')
  .map((part) => part[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/template-assets/favicon.svg" />
    <link rel="icon" href="/template-assets/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={site.description} />
    <title>{documentTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <nav aria-label="Primary navigation">
          <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true">{initials}</span>
            <span>{site.title}</span>
          </a>
          {
            site.navigation.map((item) => (
              <a
                class="nav-link"
                href={item.href}
                aria-current={currentPath === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main>
      <div class="container page-shell">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <span class="footer-mark">{site.title} / personal research site</span>
        <span>© {new Date().getFullYear()} · Built for curious minds</span>
      </div>
    </footer>
  </body>
</html>
