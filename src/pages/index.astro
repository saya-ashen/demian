---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const profile = await getEntry('profile', 'profile');
if (!profile) throw new Error('Profile content is missing.');

const { home } = profile.data;
const baseUrl = import.meta.env.BASE_URL;
const toSitePath = (href: string) => {
  const path = href === '/' ? '' : href.replace(/^\/+|\/+$/g, '');
  return path ? `${baseUrl}${path}/` : baseUrl;
};
---

<Layout title={home.title}>
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="eyebrow">{home.eyebrow}</p>
      <h1 id="home-title">{home.name}</h1>
      <p class="headline">{home.headline}</p>
      <p class="lede">{home.bio}</p>
      <div class="hero-actions">
        <a class="button" href={toSitePath('/research')}>Explore my work</a>
        <a class="button secondary" href={toSitePath('/contact')}>Get in touch</a>
      </div>
    </div>
    <div class="hero-art">
      <img
        class="hero-photo"
        src={`${baseUrl}${home.portrait.src}`}
        alt={home.portrait.alt}
        width="900"
        height="1125"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </section>

  <section aria-labelledby="highlights-title">
    <div class="section-heading">
      <h2 id="highlights-title">{home.highlightsHeading}</h2>
      <span class="kicker">At a glance</span>
    </div>
    <div class="home-grid">
      <div class="panel bio-card">
        <p>{home.researchQuestion}</p>
      </div>
      <div class="panel">
        <ul class="clean-list">
          {home.highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section aria-labelledby="links-title">
    <div class="section-heading">
      <h2 id="links-title">{home.quickLinksHeading}</h2>
      <span class="kicker">Keep exploring</span>
    </div>
    <div class="panel">
      <ul class="link-list">
        {home.quickLinks.map((link) => (
          <li><a href={toSitePath(link.href)}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
